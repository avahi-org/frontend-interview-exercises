.claude/ export-ignore
.avahi/specs/templates/ export-ignore
.pre-commit-config.yaml export-ignore
.github/workflows/container-scan.yml export-ignore
.github/workflows/iac-scan.yml export-ignore
.github/workflows/secret-scan.yml export-ignore
.github/workflows/package.yml export-ignore
.github/workflows/verify-linked-issue.yml export-ignore
